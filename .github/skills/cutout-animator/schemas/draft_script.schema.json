{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Episode draft script",
  "type": "object",
  "required": ["episodeNumber", "languageCode", "scenes"],
  "properties": {
    "episodeNumber": { "type": "integer", "minimum": 1 },
    "languageCode": { "type": "string", "description": "ISO 639-1 code, e.g. en, de, tr" },
    "title": { "type": "string" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["environmentId", "characters", "lines"],
        "properties": {
          "id": { "type": "string" },
          "environmentId": { "type": "string" },
          "timeOfDay": { "enum": ["day", "sunset", "night"] },
          "ambience": { "type": "string", "description": "ElevenLabs sound-generation prompt for a looping bed" },
          "leadInSec": { "type": "number", "minimum": 0, "default": 0.4 },
          "holdSec": { "type": "number", "minimum": 0 },
          "characters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["characterId"],
              "properties": {
                "characterId": { "type": "string" },
                "pose": { "enum": ["standing", "sitting_desk"] },
                "x": { "type": "number", "minimum": 0, "maximum": 1 },
                "flip": { "type": "boolean" },
                "gestureIntensity": { "enum": ["calm", "moderate", "expressive"] }
              }
            }
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["lineType", "speakerId", "text"],
              "properties": {
                "lineType": { "enum": ["dialogue", "thought", "narration"] },
                "speakerId": { "type": "string", "description": "\"narrator\" or a registered characterId" },
                "text": { "type": "string", "minLength": 1 },
                "pauseBeforeSec": { "type": "number", "minimum": 0 }
              }
            }
          },
          "sfx": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["prompt", "atSec"],
              "properties": {
                "prompt": { "type": "string" },
                "atSec": { "type": "number", "minimum": 0 },
                "durationSec": { "type": "number", "minimum": 0.5, "maximum": 30 }
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "atSec"],
              "properties": {
                "type": {
                  "enum": ["phoneVibrate", "doorState", "lightFlicker", "characterEnter", "eyeLook", "mood", "jump"]
                },
                "atSec": { "type": "number", "minimum": 0 },
                "durationSec": { "type": "number", "minimum": 0 },
                "characterId": { "type": "string" },
                "value": {}
              }
            }
          }
        }
      }
    }
  }
}
