# Copy to .env and fill in. Never commit .env.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional fallback voice used when a character has no voiceId for the episode language.
ELEVENLABS_DEFAULT_VOICE_ID=

